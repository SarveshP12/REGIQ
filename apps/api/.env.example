# ──────────────────────────────────────────────────────────
# REGIQ API — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────
APP_NAME=REGIQ
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# ── PostgreSQL ────────────────────────────────────────────
# NOTE: these values align with `docker-compose.yml` (service name `db`).
# When running inside Docker Compose the host should be `db`.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=regiq_db
POSTGRES_USER=regiq_user
POSTGRES_PASSWORD=regiq_password
DATABASE_URL=postgresql+asyncpg://regiq_user:regiq_password@db:5432/regiq_db
# For local `python seed.py` on the host, use localhost instead of db:
# DATABASE_URL=postgresql+asyncpg://regiq_user:regiq_password@localhost:5432/regiq_db

# ── MongoDB ───────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=regiq
MONGO_URL=mongodb://localhost:27017/regiq

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key-must-be-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── ServiceNow Integration ───────────────────────────────
SERVICENOW_INSTANCE_URL=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# ── Neo4j (Phase 2: Dependency Mapping) ──────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=regiq_neo4j_pass

# ── MLflow (Phase 2: MLOps) ──────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5050

# ── AI / Embeddings (Phase 2) ────────────────────────────
EMBEDDING_MODEL=all-mpnet-base-v2
CLASSIFIER_MODEL_PATH=models/tcc_classifier
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.65

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
