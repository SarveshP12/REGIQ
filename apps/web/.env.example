# Copy to .env.local for local `npm run dev` (not required when using docker compose)

NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# Required by NextAuth (min ~32 characters for production builds)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-change-me-in-production-32chars
